# ---------------------------------------------------------------------------
# INA Analytics — environment
# Copy to .env and fill in. NEVER commit .env.
#
# Nothing in this file may be exposed to the browser. There is deliberately no
# NEXT_PUBLIC_* variable here: every Warcraft Logs call happens server-side.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://ina:ina@localhost:5432/ina?schema=public"

# --- Warcraft Logs API v2 --------------------------------------------------
# Create a client at https://www.warcraftlogs.com/api/clients
WCL_CLIENT_ID=""
WCL_CLIENT_SECRET=""

# OAuth token endpoint. Always the www host, even for Classic.
WCL_OAUTH_TOKEN_URL="https://www.warcraftlogs.com/oauth/token"

# GraphQL host. Classic guild data lives on the Classic host:
#   Classic (WotLK/Cata/MoP Classic) -> https://classic.warcraftlogs.com
#   Retail                           -> https://www.warcraftlogs.com
WCL_API_HOST="https://classic.warcraftlogs.com"

# Safety margin: pause requests once fewer than this many rate-limit points
# remain in the current hour, so an import never hard-fails on 429. One report
# costs roughly 45 points, so this is about nine reports of headroom.
WCL_POINT_RESERVE="400"
WCL_MAX_CONCURRENCY="2"

# --- Guild -----------------------------------------------------------------
# Seed values for the first guild row. Changeable later in the admin UI.
GUILD_NAME=""
GUILD_SERVER_SLUG=""
GUILD_SERVER_REGION="EU"

# --- Admin login -----------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
AUTH_SECRET=""
