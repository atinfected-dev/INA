# Normalise to LF in the repository; Git checks out with the platform's own
# line endings. Without this, a Windows working copy and the Linux VPS produce
# diffs that consist purely of line endings.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touched.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated; collapse in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
packages/wcl/schema.graphql linguist-generated=true
