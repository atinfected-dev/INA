// INA Analytics — data model
//
// Design notes that are easy to get wrong later:
//
//  * Warcraft Logs reports are identified by their `code`. That is the unique
//    key that prevents double imports. `revision` bumps when WCL reprocesses a
//    log, which is the only reason to re-import one.
//
//  * ReportFight.startTime/endTime from the API are offsets in milliseconds
//    RELATIVE to the report start. Both the offset and the resolved absolute
//    timestamp are stored: the offset is what the API wants back, the absolute
//    timestamp is what every report and leaderboard groups by.
//
//  * Per-fight performance is stored aggregated (one row per player per pull),
//    never as raw combat log events. Deaths are the one deliberate exception —
//    they are low-volume and death causes are impossible without them.
//
//  * Expansions, zones, bosses and difficulties are imported from worldData.
//    Nothing about them is hard-coded, so a new Classic expansion is a sync
//    run rather than a code change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts and a driver adapter
// from the PrismaClient constructor, not from this block.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

model Guild {
  id           String   @id @default(cuid())
  /// Warcraft Logs guild id, filled in on first successful lookup.
  wclGuildId   Int?     @unique
  name         String
  serverSlug   String
  serverRegion String
  /// GraphQL host this guild's data lives on, e.g. https://classic.warcraftlogs.com
  apiHost      String   @default("https://classic.warcraftlogs.com")
  faction      String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports  Report[]
  sessions RaidSession[]
  syncRuns SyncRun[]

  @@unique([name, serverSlug, serverRegion])
}

/// Free-form key/value settings so thresholds and labels are editable in the
/// admin UI instead of living in code. See @ina/core for the known keys.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// An achievement an officer added: a threshold on a metric, evaluated by the
/// same code as the built-in ones. `steps` is [{ tier, threshold }].
model CustomAchievement {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  metric      String
  unit        String
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// A record an officer added. With `metric` set it is computed — the subject
/// with the highest value; without, it is a manual entry for something the
/// logs cannot know, and is shown as such.
model CustomRecord {
  id          String   @id @default(cuid())
  label       String
  formula     String
  metric      String?
  unit        String?
  value       String?
  holder      String?
  holderClass String?
  context     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

/// A Hall of Fame title awarded by hand — no metric, an officer names the
/// holder. For the honours no log records.
model CustomTitle {
  id          String   @id @default(cuid())
  title       String
  subtitle    String
  holder      String
  holderClass String?
  note        String?
  /// classic or forever: which Hall of Fame the plaque hangs in.
  era         String   @default("classic")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([era])
}

/// The character a member intends to play in World of Warcraft: Forever.
/// One per account; a plan, not a record.
model ForeverCharacter {
  id        String   @id @default(cuid())
  accountId String   @unique
  /// Forever characters have a first and a last name.
  name      String
  surname   String   @default("")
  race      String
  className String
  faction   String
  role      String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Officers' notes, guides and raid sheets for Forever. `kind` is one of
/// info, guide, sheet; `url` links out to a sheet or document.
model ForeverPost {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String
  url       String?
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, pinned, createdAt])
}

/// A registered guild member.
///
/// Separate from Person on purpose: Person is the analytical identity that an
/// admin can maintain whether or not the human ever signs up, and character
/// history must not depend on someone creating an account. An account links to
/// a Person once a claim is confirmed.
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Shown to signed-in members only. Never selected on public pages.
  realName     String?
  /// Public handle, safe to show anywhere.
  displayName  String
  isAdmin      Boolean  @default(false)
  isActive     Boolean  @default(true)
  personId     String?  @unique
  /// Achievement ids pinned to the profile, in display order, at most six.
  pinnedAchievements String[] @default([])
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  person   Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  claims   CharacterClaim[]
  sessions Session[]
  forever  ForeverCharacter?
  builds   ForeverBuild[]
  nameVotes GuildNameVote[]
}

model Session {
  /// Opaque random token; only its hash is stored.
  tokenHash String   @id
  accountId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A member's request to be recognised as the owner of a character.
///
/// Approval is manual. Nothing in a Warcraft Logs report proves who sat at the
/// keyboard, so the guild vouches for it rather than the software pretending to
/// verify something it cannot.
model CharacterClaim {
  id          String      @id @default(cuid())
  accountId   String
  characterId String
  status      ClaimStatus @default(PENDING)
  /// Optional note from the requester, e.g. "mein Zweitchar seit Cata".
  note        String?
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  /// Reason shown to the requester when a claim is rejected.
  decisionNote String?

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([accountId, characterId])
  @@index([status])
  @@index([characterId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// ---------------------------------------------------------------------------
// Game reference data (imported from worldData)
// ---------------------------------------------------------------------------

model Expansion {
  id             String  @id @default(cuid())
  wclExpansionId Int     @unique
  name           String
  slug           String  @unique
  /// The API exposes no expansion dates; these are derived from report
  /// timestamps during import and may be adjusted in the admin UI.
  startDate      DateTime?
  endDate        DateTime?
  sortOrder      Int     @default(0)

  zones Zone[]
}

/// A raid instance (Naxxramas, Ulduar, Siege of Orgrimmar, ...).
model Zone {
  id          String  @id @default(cuid())
  wclZoneId   Int     @unique
  name        String
  /// Display/URL helper only — deliberately NOT unique. Warcraft Logs models
  /// every re-release of a raid as its own zone: Ulduar exists as 1017 (Normal
  /// only) and 1026 (with Heroic), Naxxramas as 1006 and 1036. Same name, same
  /// expansion, different data. Identity is wclZoneId; URLs use
  /// "<wclZoneId>-<slug>".
  slug        String
  frozen      Boolean @default(false)
  sortOrder   Int     @default(0)
  expansionId String

  expansion    Expansion       @relation(fields: [expansionId], references: [id], onDelete: Cascade)
  encounters   Encounter[]
  difficulties ZoneDifficulty[]
  reports      Report[]

  @@index([expansionId])
  @@index([slug])
}

/// A boss.
model Encounter {
  id             String @id @default(cuid())
  wclEncounterId Int    @unique
  name           String
  slug           String
  journalId      Int?
  sortOrder      Int    @default(0)
  zoneId         String

  zone   Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  fights Fight[]

  @@unique([zoneId, slug])
  @@index([zoneId])
}

model Difficulty {
  id              String @id @default(cuid())
  wclDifficultyId Int    @unique
  name            String

  zones  ZoneDifficulty[]
  fights Fight[]
}

/// Difficulties are reported per zone, together with the raid sizes they allow.
model ZoneDifficulty {
  zoneId       String
  difficultyId String
  sizes        Int[]

  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  difficulty Difficulty @relation(fields: [difficultyId], references: [id], onDelete: Cascade)

  @@id([zoneId, difficultyId])
}

// ---------------------------------------------------------------------------
// Identity: a person plays many characters across the years
// ---------------------------------------------------------------------------

model Person {
  id          String   @id @default(cuid())
  displayName String
  slug        String   @unique
  note        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters  Character[]
  attendance  SessionAttendance[]
  account     Account?
}

model Character {
  id              String    @id @default(cuid())
  /// Warcraft Logs character id, when the log exposes one.
  wclCharacterId  Int?      @unique
  name            String
  /// Realm exactly as the log reports it, for display.
  realmName       String
  /// Normalised realm for identity. Falls back to realmName when the realm has
  /// no latin characters to slugify (CJK realms), so identity stays stable.
  realmSlug       String
  region          String
  /// Class as reported by the logs; null until a fight reveals it.
  className       String?
  mainSpec        String?
  personId        String?
  firstSeenAt     DateTime?
  lastSeenAt      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  person        Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  claims        CharacterClaim[]
  nameHistory   CharacterNameHistory[]
  participation FightParticipant[]
  performances  FightPerformance[]
  rankings      ParseRanking[]
  deaths        DeathEvent[]
  attendance    SessionAttendance[]
  utility       ReportUtility[]

  @@unique([name, realmSlug, region])
  @@index([personId])
  @@index([className])
}

/// Renames and transfers, so a character's history survives a name change.
model CharacterNameHistory {
  id          String   @id @default(cuid())
  characterId String
  name        String
  realmSlug   String
  seenFrom    DateTime
  seenTo      DateTime

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Reports and fights
// ---------------------------------------------------------------------------

enum ImportState {
  DISCOVERED
  FIGHTS_IMPORTED
  ANALYZED
  FAILED
}

model Report {
  id          String      @id @default(cuid())
  /// Warcraft Logs report code — the unique key that prevents double imports.
  code        String      @unique
  guildId     String
  title       String
  startTime   DateTime
  endTime     DateTime
  /// Bumped by Warcraft Logs when a log is reprocessed; a change triggers re-import.
  revision    Int         @default(0)
  visibility  String?
  ownerName   String?
  zoneId      String?
  importState ImportState @default(DISCOVERED)
  /// Warcraft Logs archives report CONTENTS after roughly two years. Rankings
  /// survive, so parses stay complete, but table() no longer answers and the
  /// data would need the user-authenticated endpoint. Recorded so archived
  /// reports are not queried again on every run.
  contentsArchived Boolean @default(false)
  /// Interrupts and dispels are fetched once for the whole report; see ReportUtility.
  utilityImported Boolean @default(false)
  importError String?
  importedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  guild    Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  zone     Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  fights   Fight[]
  sessions SessionReport[]
  utility  ReportUtility[]

  @@index([guildId, startTime])
  @@index([importState])
  @@index([utilityImported])
}

/// Interrupts and dispels, per report and character.
///
/// Deliberately NOT per fight. `table(dataType: Interrupts)` sums everything
/// in the requested range and puts no fight id on its entries, so per-fight
/// numbers could only be produced by splitting a total up arbitrarily. One
/// request covers a whole report for the same few points a single pull costs,
/// so this is both the honest granularity and by far the cheaper one.
model ReportUtility {
  id          String @id @default(cuid())
  reportId    String
  characterId String
  interrupts  Int    @default(0)
  dispels     Int    @default(0)

  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([reportId, characterId])
  @@index([characterId])
}

model Fight {
  id           String   @id @default(cuid())
  reportId     String
  /// Fight id within the report; unique only together with the report.
  wclFightId   Int
  /// 0 means trash. Kept raw so unmatched encounters are still traceable.
  wclEncounterId Int
  encounterId  String?
  difficultyId String?
  /// Raw difficulty int from the API, kept even when no Difficulty row matches.
  wclDifficulty Int?
  size         Int?
  kill         Boolean?
  /// Offsets in milliseconds relative to the report start, as the API returns them.
  startOffsetMs Int
  endOffsetMs   Int
  /// Absolute timestamps, resolved as report.startTime + offset.
  startTime    DateTime
  endTime      DateTime
  durationMs   Int
  bossPercentage   Float?
  fightPercentage  Float?
  lastPhase        Int?
  averageItemLevel Float?
  hardModeLevel    Int?
  completeRaid     Boolean @default(false)
  wipeCalledMs     Int?
  /// Damage taken needs one API call per fight — the table endpoint returns no
  /// per-fight breakdown when several fights are requested at once. The flag
  /// makes a multi-hour backfill resumable.
  damageTakenImported Boolean @default(false)

  report       Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  encounter    Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  difficulty   Difficulty?        @relation(fields: [difficultyId], references: [id], onDelete: SetNull)
  participants FightParticipant[]
  performances FightPerformance[]
  rankings     ParseRanking[]
  deaths       DeathEvent[]

  @@unique([reportId, wclFightId])
  @@index([encounterId, kill])
  @@index([startTime])
  // Backs the "what is left to do" scan over the whole table.
  @@index([damageTakenImported])
}

model FightParticipant {
  id          String  @id @default(cuid())
  fightId     String
  characterId String
  spec        String?
  role        String?
  itemLevel   Int?

  fight     Fight     @relation(fields: [fightId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([fightId, characterId])
  @@index([characterId])
}

// ---------------------------------------------------------------------------
// Performance — aggregated per player per pull
// ---------------------------------------------------------------------------

model FightPerformance {
  id          String  @id @default(cuid())
  fightId     String
  characterId String
  role        String?
  spec        String?

  damageDone     BigInt @default(0)
  bossDamageDone BigInt @default(0)
  damageTaken    BigInt @default(0)
  healingDone    BigInt @default(0)
  overhealing    BigInt @default(0)
  dps            Float  @default(0)
  hps            Float  @default(0)
  deaths         Int    @default(0)
  interrupts     Int    @default(0)
  dispels        Int    @default(0)
  activeTimeMs   Int    @default(0)
  itemLevel      Int?

  fight     Fight     @relation(fields: [fightId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([fightId, characterId])
  @@index([characterId])
}

enum ParseMetric {
  DPS
  HPS
}

/// Warcraft Logs only ranks kills, so wipes produce no rows here. The UI states
/// this explicitly rather than silently showing a smaller sample.
model ParseRanking {
  id            String      @id @default(cuid())
  fightId       String
  characterId   String
  metric        ParseMetric
  /// Percentile against everyone who killed this boss.
  rankPercent   Float
  /// Percentile against players in a comparable item level bracket.
  bracketPercent Float?
  spec          String?
  partition     Int?

  fight     Fight     @relation(fields: [fightId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([fightId, characterId, metric])
  @@index([characterId, metric])
  @@index([rankPercent])
}

/// One row per death. The cause is null when the log does not identify it —
/// never guessed.
model DeathEvent {
  id          String  @id @default(cuid())
  fightId     String
  characterId String
  /// Offset in milliseconds relative to the report start.
  timestampMs Int
  abilityId   Int?
  abilityName String?
  sourceName  String?

  fight     Fight     @relation(fields: [fightId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([fightId])
  @@index([abilityId])
}

// ---------------------------------------------------------------------------
// Raid nights and attendance
// ---------------------------------------------------------------------------

/// One raid night. May span several reports if the raid leader split the log.
model RaidSession {
  id         String   @id @default(cuid())
  guildId    String
  date       DateTime @db.Date
  startTime  DateTime
  endTime    DateTime
  durationMs Int

  guild      Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reports    SessionReport[]
  attendance SessionAttendance[]

  @@unique([guildId, startTime])
  @@index([guildId, date])
}

model SessionReport {
  sessionId String
  reportId  String

  session RaidSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  report  Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([sessionId, reportId])
}

model SessionAttendance {
  id          String  @id @default(cuid())
  sessionId   String
  characterId String
  personId    String?
  /// Summed fight time the character actually took part in.
  activeMs    Int
  /// activeMs as a share of the session duration, 0..1.
  participation Float
  /// Result of applying the configured threshold to activeMs/participation.
  isPresent   Boolean

  session   RaidSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  character Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  person    Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([sessionId, characterId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Aggregates that back the leaderboards
// ---------------------------------------------------------------------------

enum SubjectType {
  PERSON
  CHARACTER
}

enum ScopeType {
  ALL
  EXPANSION
  ZONE
  ENCOUNTER
}

/// One row per subject per metric per scope. `sampleSize` is always carried
/// alongside the value and is shown in the UI, which is what makes the
/// minimum-sample rankings honest instead of a hidden filter.
model AggregateStat {
  id          String      @id @default(cuid())
  subjectType SubjectType
  subjectId   String
  scopeType   ScopeType
  /// Null for ScopeType.ALL; otherwise the Expansion/Zone/Encounter id.
  scopeId     String?
  /// Null means "all difficulties".
  difficultyId String?
  /// Metric key; the allowed values are defined in @ina/core so new statistics
  /// do not require a migration.
  metric      String
  value       Float
  sampleSize  Int         @default(0)
  computedAt  DateTime    @default(now())

  @@unique([subjectType, subjectId, scopeType, scopeId, difficultyId, metric])
  @@index([metric, scopeType, scopeId, value])
  @@index([subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Sync bookkeeping
// ---------------------------------------------------------------------------

enum SyncType {
  FULL
  INCREMENTAL
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model SyncRun {
  id          String     @id @default(cuid())
  guildId     String
  type        SyncType
  status      SyncStatus @default(RUNNING)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  newReports  Int        @default(0)
  newFights   Int        @default(0)
  /// Warcraft Logs meters usage in fractional points, hence Float.
  pointsSpent Float      @default(0)
  error       String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, startedAt])
}

/// A shared Forever talent build. `code` is the whole build (one digit per
/// talent, trees joined by "-"); private builds are never stored, only linked.
model ForeverBuild {
  id        String   @id @default(cuid())
  className String
  title     String
  code      String
  authorId  String?
  views     Int      @default(0)
  score     Int      @default(0)
  createdAt DateTime @default(now())

  author Account?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes  ForeverBuildVote[]

  @@index([className, score])
  @@index([className, views])
  @@index([className, createdAt])
}

/// One vote per browser and build; the hash never identifies a person.
model ForeverBuildVote {
  buildId   String
  voterHash String
  createdAt DateTime @default(now())

  build ForeverBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@id([buildId, voterHash])
}

/// A candidate for the guild's name in Forever. Seeded by migration; officers
/// may add more from the poll page.
model GuildNameOption {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  votes GuildNameVote[]
}

/// One member, one vote per name: +1 or -1. Changing your mind overwrites.
model GuildNameVote {
  optionId  String
  accountId String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  option  GuildNameOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([optionId, accountId])
  @@index([accountId])
}
